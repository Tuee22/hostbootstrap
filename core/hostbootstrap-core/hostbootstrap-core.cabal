cabal-version: 3.12
name: hostbootstrap-core
version: 0.1.0.0
synopsis: Reusable host-management core for the hostbootstrap project family
category: Development
description:
  hostbootstrap-core owns the host-management logic shared across the project
  family: host-tool resolution, substrate detection, the @ensure@ reconcilers,
  the project-local @<project>.dhall@ decoder, cluster-lifecycle semantics, and
  the composable optparse-applicative command tree project binaries extend
  through @runHostBootstrapCLI@.
license: MIT
author: hostbootstrap contributors
maintainer: hostbootstrap contributors
build-type: Simple
tested-with: GHC ==9.12.4
extra-source-files:
    test/compile-fail/*.hs

flag provider-live
  description: Build the explicitly confirmed native Linux provider lifecycle gate
  default: False
  manual: True

common warnings
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints

library effect-internal
  import: warnings
  visibility: private
  hs-source-dirs: internal/effect
  exposed-modules:
      HostBootstrap.Effect.Quote
      HostBootstrap.Effect.Run
  build-depends:
      base >=4.18 && <5
    , bytestring
    , process
  if !os(windows)
    build-depends:
        unix

library harness-lifecycle-internal
  import: warnings
  visibility: private
  hs-source-dirs: internal/harness-lifecycle
  exposed-modules:
      HostBootstrap.Harness.Lifecycle.Internal
  build-depends:
      base >=4.18 && <5

library colima-backend-internal
  import: warnings
  visibility: private
  hs-source-dirs: internal/colima-backend
  exposed-modules:
      HostBootstrap.Ensure.Colima.Backend.Internal
      HostBootstrap.Ensure.Colima.Backend.Resolver
      HostBootstrap.Ensure.Colima.Backend.Resolver.Install
      HostBootstrap.Ensure.Colima.Backend.Resolver.Testing
  other-modules:
