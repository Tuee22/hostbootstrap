test-suite hostbootstrap-provider-live-linux-cpu
  import: warnings
  type: exitcode-stdio-1.0
  hs-source-dirs: provider-live
  main-is: ProviderLiveMain.hs
  other-modules:
      ProviderLiveAliasFixture
      ProviderLiveConfig
      ProviderLiveRunner
  ghc-options: -threaded
  build-depends:
      base >=4.18 && <5
    , dhall
    , directory
    , filepath
    , hostbootstrap-core
    , hostbootstrap-core:lifecycle-representation-internal
    , process
    , temporary
    , text
  -- This suite is compiled everywhere and decides at runtime whether its subject
  -- is available, because a component excluded from the default build is a
  -- component no gate compiles: it went fifteen days without compiling behind a
  -- default-off flag, and reported the same green nothing a passing suite does.
  -- The destructive guard it needs lives in requirePlatformAndConfirmation, not
  -- in a build condition.
