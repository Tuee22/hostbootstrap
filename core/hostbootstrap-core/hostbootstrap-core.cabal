      HostBootstrap.Ensure.Colima.Backend.Program.LiveDocker
      HostBootstrap.Ensure.Colima.Backend.Program.Namespace
      HostBootstrap.Ensure.Colima.Backend.Program.Supervisor
      HostBootstrap.Ensure.Colima.Backend.Resolver.Authority
      HostBootstrap.Ensure.Colima.Backend.Resolver.Program
      HostBootstrap.Ensure.Colima.Backend.Resolver.Override
      HostBootstrap.Ensure.Colima.Backend.Resolver.Protocol
      HostBootstrap.Ensure.Colima.Backend.Runner
  build-depends:
      base >=4.18 && <5
    , bytestring
    , filepath
    , hostbootstrap-core:effect-internal
    , process
  if !os(windows)
    build-depends:
        unix

