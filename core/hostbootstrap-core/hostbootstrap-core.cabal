test-suite hostbootstrap-provider-live-linux-cpu
  import: warnings
  type: exitcode-stdio-1.0
  hs-source-dirs: provider-live
  main-is: ProviderLiveMain.hs
  other-modules:
      ProviderLiveAliasFixture
      ProviderLiveConfig
      ProviderLiveRunner
  ghc-options: -threaded
  build-depends:
      base >=4.18 && <5
    , dhall
    , directory
    , filepath
    , hostbootstrap-core
    , process
    , temporary
    , text
  -- The opt-in flag is the whole gate. A second host condition that silently
  -- made the suite unbuildable would answer "asked for and not built" with the
  -- same green nothing as "not asked for", which is the shape § JJ's fifth rule
  -- forbids: an operator who asks for this suite on a host that cannot run it
  -- is told so by the build rather than handed an empty pass.
  if !flag(provider-live)
    buildable: False
