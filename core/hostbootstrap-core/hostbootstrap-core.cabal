      aeson
    , base >=4.18 && <5
    , bytestring
    , containers
    , crypton
    , directory
    , dhall
    , filepath
    , hostbootstrap-core:effect-internal
    , hostbootstrap-core:harness-lifecycle-internal
    , hostbootstrap-core:colima-backend-internal
    , memory
    , optparse-applicative
    , process
    , safe-exceptions
    , text
  -- Every module is built on every host, so a platform row is a refusal a
  -- caller can read rather than a module that is not there, and the case that
  -- covers it asserts that refusal instead of disappearing (§ JJ). Only the
  -- platform library each row binds to is conditional.
  if !os(windows)
    build-depends:
        unix
  if os(windows)
    build-depends:
        Win32

executable hostbootstrap
  import: warnings
  hs-source-dirs: app
  main-is: Main.hs
  build-depends:
      base >=4.18 && <5
    , hostbootstrap-core

