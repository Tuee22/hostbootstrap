cabal-version: 3.12
name: hostbootstrap-core
version: 0.1.0.0
synopsis: Reusable host-management core for the hostbootstrap project family
category: Development
description:
  hostbootstrap-core owns the host-management logic shared across the project
  family: host-tool resolution, substrate detection, the @ensure@ reconcilers,
  the project-local @<project>.dhall@ decoder, cluster-lifecycle semantics, and
  the composable optparse-applicative command tree project binaries extend
  through @runHostBootstrapCLI@.
license: MIT
author: hostbootstrap contributors
maintainer: hostbootstrap contributors
build-type: Simple
tested-with: GHC ==9.12.4
extra-source-files:
    test/compile-fail/*.hs

common warnings
  default-language: Haskell2010
  -- The warning policy is a property of this package, not of a flag each caller
  -- remembers to pass: a plain `cabal build` holds exactly what the gate holds.
  -- `-Wpartial-fields` is here because a partial record selector throws at the
  -- call site rather than failing to compile; a sum's fields are eliminated
  -- positionally instead.
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints -Wpartial-fields -Werror

