cabal-version: 3.12
name: hostbootstrap-core
version: 0.1.0.0
synopsis: Reusable host-management core for the hostbootstrap project family
category: Development
description:
  hostbootstrap-core owns the host-management logic shared across the project
  family: host-tool resolution, substrate detection, the @ensure@ reconcilers,
  the project-local @<project>.dhall@ decoder, cluster-lifecycle semantics, and
  the composable optparse-applicative command tree project binaries extend
  through @runHostBootstrapCLI@.
license: MIT
author: hostbootstrap contributors
maintainer: hostbootstrap contributors
build-type: Simple
tested-with: GHC ==9.12.4
extra-source-files:
    test/compile-fail/*.hs

common warnings
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints

library
  import: warnings
  hs-source-dirs: src
  exposed-modules:
      HostBootstrap.CLI
      HostBootstrap.Command
      HostBootstrap.HostTool
      HostBootstrap.HostConfig
      HostBootstrap.Authority
      HostBootstrap.Activation
      HostBootstrap.Build
      HostBootstrap.Detached
      HostBootstrap.Handoff
      HostBootstrap.Lifecycle.Execution
      HostBootstrap.Lifecycle.Prepared
      HostBootstrap.Lifecycle.Session
      HostBootstrap.Lifecycle.Session.Testing
      HostBootstrap.Protected
      HostBootstrap.Readiness
      HostBootstrap.Reconcile
      HostBootstrap.HostPrereqs
      HostBootstrap.Substrate
      HostBootstrap.Substrate.Provider
      HostBootstrap.Substrate.Provider.Alias
      HostBootstrap.Ensure
      HostBootstrap.Ensure.AppleMetal
      HostBootstrap.Ensure.Docker
      HostBootstrap.Ensure.Colima
      HostBootstrap.Ensure.Cuda
      HostBootstrap.Ensure.CudaWin
      HostBootstrap.Ensure.Homebrew
      HostBootstrap.Ensure.Ghc
      HostBootstrap.Ensure.Incus
      HostBootstrap.Ensure.Lima
      HostBootstrap.Ensure.Wsl2
      HostBootstrap.Incus
      HostBootstrap.Lima
      HostBootstrap.Wsl2
      HostBootstrap.Wsl2.GlobalWall
      HostBootstrap.Wsl2.GlobalWall.ConfigBytes
      HostBootstrap.Wsl2.GlobalWall.Host
      HostBootstrap.Wsl2.GlobalWall.Windows
      HostBootstrap.Lifecycle.Mode
      HostBootstrap.Lift
      HostBootstrap.Step
      HostBootstrap.Teardown
      HostBootstrap.Chain
      HostBootstrap.Network
      HostBootstrap.Registry
      HostBootstrap.RegistryPlan
      HostBootstrap.RoleLifecycle
      HostBootstrap.Context
      HostBootstrap.ProjectRoot
      HostBootstrap.Config.Class
      HostBootstrap.Config.Fields
      HostBootstrap.Config.Schema
      HostBootstrap.Config.Vocab
      HostBootstrap.Dhall.Gen
      HostBootstrap.Dhall.Hoist
      HostBootstrap.Cluster.Lifecycle
      HostBootstrap.Cluster.Cordon
      HostBootstrap.Cluster.Budget
      HostBootstrap.Cluster.Reconcile
      HostBootstrap.Cluster.Backend
      HostBootstrap.Harness
      HostBootstrap.Harness.DataRoot
      HostBootstrap.Harness.GeneratedConfig
      HostBootstrap.Harness.Identity
      HostBootstrap.Harness.Identity.Native
      HostBootstrap.Harness.Ownership
      HostBootstrap.Service
      HostBootstrap.DocValidator
  other-modules:
      HostBootstrap.Config.Authority.Internal
      HostBootstrap.Config.Fields.Internal
      HostBootstrap.Config.Install.Native
      HostBootstrap.Handoff.Protocol
      HostBootstrap.Lifecycle.Execution.Internal
      HostBootstrap.Lifecycle.Plan
      HostBootstrap.Lifecycle.Prepared.Internal
      HostBootstrap.Lifecycle.Transaction
  build-depends:
      aeson
    , base >=4.18 && <5
    , bytestring
    , containers
    , crypton
    , directory
    , dhall
    , filepath
    , memory
    , optparse-applicative
    , process
    , safe-exceptions
    , text
  if !os(windows)
    exposed-modules:
        HostBootstrap.Wsl2.GlobalWall.Posix
    build-depends:
        unix
  if os(windows)
    build-depends:
        Win32

executable hostbootstrap
  import: warnings
  hs-source-dirs: app
  main-is: Main.hs
  build-depends:
      base >=4.18 && <5
    , hostbootstrap-core

test-suite hostbootstrap-core-test
  import: warnings
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  other-modules:
      Fixture
      PrepareFixture
      AuthoritySpec
      HandoffProtocolSpec
      HandoffSpec
      SessionSpec
      BuildAuthoritySpec
      ActivationSpec
      BudgetSpec
      ReadinessSpec
      ReconcileSpec
      CLISpec
      CompileFailSpec
      DetachedSpec
      SubstrateSpec
      HostToolSpec
      EnsureSpec
      SchemaSpec
      DhallGenSpec
      CordonSpec
      ProviderSpec
      ProviderAliasSpec
      ClusterReconcileSpec
      ClusterBackendSpec
      DataRootSpec
      GeneratedConfigSpec
      ProjectRootSpec
      ContextSpec
      LifecycleSpec
      HarnessSpec
      IncusSpec
      LimaSpec
      Wsl2Spec
      WslGlobalWallSpec
      WslGlobalWallConfigBytesSpec
      LiftSpec
      StepSpec
      ChainSpec
      ColimaSpec
      RegistrySpec
      RegistryPlanSpec
      RoleLifecycleSpec
      TeardownSpec
      DocValidatorSpec
  if os(windows)
    other-modules:
        WslGlobalWallWindowsSpec
  else
    other-modules:
        WslGlobalWallHostSpec
  build-depends:
      base >=4.18 && <5
    , bytestring
    , containers
    , dhall
    , directory
    , filepath
    , hostbootstrap-core
    , optparse-applicative
    , process
    , tasty
    , tasty-hunit
    , temporary
    , text
