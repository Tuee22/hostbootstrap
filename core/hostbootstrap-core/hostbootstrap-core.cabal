-- The durable state an interrupted lifecycle transaction leaves, and the
-- vocabulary a recovery fixture writes it in. Private for the same reason the
-- colima-backend-internal's private HostBootstrap.Ensure.Colima.Backend.Resolver.Testing is:
-- the types mint no authority, but the bytes
-- they render are the coordinator's own, and a downstream consumer that could
-- write them could put the store into a state no run produced.
-- Only Session.Testing is exposed; Transaction stays hidden in this unit.
-- Main consumes the hidden production copy in handoff-implementation-internal.
library lifecycle-transaction-internal
  import: warnings
  visibility: private
  hs-source-dirs: src, internal/handoff-implementation
  exposed-modules:
      HostBootstrap.Lifecycle.Session.Testing
  other-modules:
      HostBootstrap.Lifecycle.Transaction
  build-depends:
      base >=4.18 && <5
    , bytestring
    , crypton <1.1
    , memory
    , text
    , hostbootstrap-core:ownership-internal

