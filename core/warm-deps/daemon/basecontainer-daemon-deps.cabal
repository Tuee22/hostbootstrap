cabal-version: 3.12
name: basecontainer-daemon-deps
version: 0.1.0.0
synopsis: Daemon-family group for the basecontainer warm Cabal store
category: Development
description:
  Cache-population inputs for daemon-family dependencies — the Redis / Postgres / proto /
  secure-websocket-client stack (`hedis`, `postgresql-simple`, `proto-lens*`,
  `wuss`). Listing them as one tiny executable's build-depends lets the base build
  prebuild them into the shared Cabal store.
  .
  Note: `http-client` / `http-client-tls` are NOT here — they are pulled into the
  core closure by `dhall` (remote imports), so the core manifest already lists them.
  .
  Consumers do not import this package or a generated freeze. The base, core,
  and shared web-build cache inputs live in the sibling
  `basecontainer-core-deps.cabal`.
  See documents/engineering/warm_store.md.
license: MIT
author: basecontainer contributors
maintainer: basecontainer contributors
build-type: Simple
tested-with: GHC >=9.6 && <9.14

executable basecontainer-daemon-deps
  main-is: Main.hs
  hs-source-dirs: app
  default-language: Haskell2010
  build-depends:
      base >=4.18 && <5
    , hedis
    , postgresql-simple
    , proto-lens
    , proto-lens-runtime
    , proto-lens-setup
    , wuss
