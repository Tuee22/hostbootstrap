cabal-version: 3.12
name: basecontainer-core-deps
version: 0.1.0.0
synopsis: Core and web group for the basecontainer warm Cabal store
category: Development
description:
  Cache-population inputs for the `hostbootstrap-core` dependency closure and
  shared web-build extras
  (`purescript-bridge` for the demo's web bridge, and the web-server stack —
  `warp` / `wai*` / `network` / `http-types` / `websockets` — an L0-direct web
  consumer such as the demo needs). Listing these as one tiny executable's
  build-depends lets the base build populate one shared Cabal store.
  .
  Consumers do not import this package or a generated freeze. The daemon-family
  cache-population inputs live in the sibling `basecontainer-daemon-deps.cabal`.
  Matching inherited artifacts are reused opportunistically.
  See documents/engineering/warm_store.md.
license: MIT
author: basecontainer contributors
maintainer: basecontainer contributors
build-type: Simple
tested-with: GHC >=9.6 && <9.14

executable basecontainer-core-deps
  main-is: Main.hs
  hs-source-dirs: app
  default-language: Haskell2010
  build-depends:
      QuickCheck
    , aeson
    , aeson-pretty
    , ansi-terminal
    , async
    , base >=4.18 && <5
    , base16-bytestring
    , base64-bytestring
    , brick
    , case-insensitive
    , cborg
    , cborg-json
    , co-log
    , co-log-core
    , containers
    , cookie
    , criterion
    , cryptohash-sha1
    , cryptohash-sha256
    , cryptonite
    , dhall
    , directory
    , filepath
    , flat
    , fsnotify
    , hedgehog
    , hspec
    , http-types
    , lens-family
    , lens-family-core
    , memory
    , mtl
    , network
    , optparse-applicative
    , path
    , path-io
    , prettyprinter
    , prettyprinter-ansi-terminal
    , process
    , purescript-bridge
    , random
    , safe-exceptions
    , scientific
    , serialise
    , stm
    , tasty
    , tasty-golden
    , tasty-hedgehog
    , tasty-hunit
    , tasty-quickcheck
    , temporary
    , text
    , time
    , transformers
    , typed-process
    , unix
    , uuid
    , vector
    , vty
    , wai
    , wai-websockets
    , warp
    , websockets
    , yaml
    , zlib
