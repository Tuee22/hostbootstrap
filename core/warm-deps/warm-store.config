-- Shared warm-store build configuration imported by cabal.project.
--
-- These ways broaden the chance of downstream artifact reuse. They are an
-- optimization, not a guarantee: consumers may select other plans and compile
-- cache misses normally.
builddir: /opt/build/haskell/basecontainer-deps/dist-newstyle

tests: True
benchmarks: True
shared: True

optimization: 2
