-- Shared warm-store build configuration imported by cabal.project.
--
-- Top-level options in a cabal.project (optimization, tests, benchmarks,
-- shared) reach only that project's local packages. Here they shape the two
-- stub packages and the solver plan; the store's dependencies take Cabal's
-- per-package defaults, so nothing below aligns dependency builds for reuse.
-- The store is an opportunistic cache: consumers may select other plans and
-- compile cache misses normally.
builddir: /opt/build/haskell/basecontainer-deps/dist-newstyle

tests: True
benchmarks: True
shared: True

optimization: 2
