-- hostbootstrap-core build configuration (the self-contained Haskell workspace).
--
-- The GHC pin is the family constant: the same version the Python bootstrapper
-- installs on the host, the base image build receives as GHC_VERSION, and the
-- guest bootstrap pins in a VM (see ../documents/engineering/cabal_layout.md).
-- It has to match the base, because the compiler keys the warm Cabal store --
-- a base on another compiler would ship a store this workspace cannot read and
-- could not configure this project at all. The optimisation level matches that
-- store for the same reason, so derived project builds reuse the pre-built
-- dependency unfoldings. That store is built from the warm-store project at
-- core/warm-deps/ in this repository (../documents/engineering/warm_store.md).

packages:
  hostbootstrap-core/hostbootstrap-core.cabal

with-compiler: ghc-9.12.4

optimization: 2

-- Bounded host memory. A per-process RTS cap is not a host bound on its own -- the bound is the cap
-- times the number of compiler processes -- so the job count is pinned beside it, making the compiler
-- subtotal here 1 job x 6144 MiB. This is precautionary: an unbounded parallel build can drive a
-- workstation into the kernel's out-of-memory path, and the build configuration is where that bound
-- has to live, because nothing downstream of it can reimpose one.
jobs: 1

package *
  ghc-options: +RTS -M6144M -xr18432M -RTS
