-- hostbootstrap-core build configuration (the self-contained Haskell workspace).
--
-- The GHC pin matches the base-image toolchain (see
-- ../documents/engineering/cabal_layout.md and haskell-deps/cabal.project).
-- The optimisation level matches the warm Cabal store baked into the base image
-- so derived project builds reuse the pre-built dependency unfoldings
-- (../documents/engineering/warm_store.md).

packages:
  hostbootstrap-core/hostbootstrap-core.cabal

with-compiler: ghc-9.12.4

optimization: 2

-- Bounded host memory, added 2026-08-14. Mirrors what `infernix init` generates for itself in
-- ~/infernix/cabal.project.local; doctrine in ~/infernix/documents/architecture/bounded_host_memory.md.
-- A per-process cap is not a host bound on its own: the compiler subtotal here is
-- 1 job x 6144 MiB. This is precautionary — the 2026-08-14 kernel panic was NOT caused by this
-- project (its `cabal test all` finished cleanly 39 minutes before the panic, with zero cabal
-- processes present in either jetsam snapshot).
jobs: 1

package *
  ghc-options: +RTS -M6144M -xr18432M -RTS
